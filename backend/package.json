{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "description": "API para gerenciamento de biblioteca",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc && node dist/server.js",
    "build": "tsc --skipLibCheck",
    "start": "node dist/server.js",
    "prisma:generate": "npx @prisma/client generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:reset": "npx prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx src/scripts/seedDatabse.ts",
    "render:build": "npm install && npm run build",
    "render:start": "npx prisma generate && npx prisma migrate deploy && npm run seed && node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
